---
export interface Props {
  pretitle?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
}

const { pretitle, title, subtitle, align = 'center' } = Astro.props;

const alignClasses = {
  left: 'text-left',
  center: 'text-center',
};

const subtitleAlignClasses = {
  left: 'text-left',
  center: 'text-center mx-auto',
};
---

<div class={`mb-12 ${alignClasses[align]}`}>
  {pretitle && (
    <p class="text-sm font-semibold uppercase tracking-wider text-[#0369A1] mb-3">
      {pretitle}
    </p>
  )}
  <h2 class="text-3xl sm:text-4xl font-bold text-[#0F172A]">
    {title}
  </h2>
  {subtitle && (
    <p class={`text-lg text-[#334155] mt-4 max-w-2xl ${subtitleAlignClasses[align]}`}>
      {subtitle}
    </p>
  )}
</div>
