---
export interface Props {
  quote: string;
  name: string;
  role: string;
  initials: string;
  rating: number;
}

const { quote, name, role, initials, rating } = Astro.props;
---

<div class="bg-white border border-[#E2E8F0] rounded-xl p-6 flex flex-col gap-4">
  <div class="flex gap-1">
    {Array.from({ length: rating }).map(() => (
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="#FBBF24" stroke="#FBBF24" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
      </svg>
    ))}
  </div>
  <blockquote class="text-[#334155] text-sm leading-relaxed flex-1">
    "{quote}"
  </blockquote>
  <div class="flex items-center gap-3 pt-2 border-t border-[#E2E8F0]">
    <div class="w-10 h-10 rounded-full bg-[#E0F2FE] flex items-center justify-center text-[#0369A1] font-semibold text-sm flex-shrink-0">
      {initials}
    </div>
    <div>
      <p class="font-semibold text-[#0F172A] text-sm">{name}</p>
      <p class="text-xs text-[#334155]">{role}</p>
    </div>
  </div>
</div>
