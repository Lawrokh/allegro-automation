---
export interface Props {
  question: string;
  answer: string;
}

const { question, answer } = Astro.props;
---

<details class="group py-5">
  <summary class="flex items-center justify-between gap-4 cursor-pointer list-none font-semibold text-[#0F172A] hover:text-[#0369A1] transition-colors duration-150">
    <span>{question}</span>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="flex-shrink-0 transition-transform duration-200 group-open:rotate-180"
      aria-hidden="true"
    >
      <polyline points="6 9 12 15 18 9"/>
    </svg>
  </summary>
  <div class="mt-4 text-[#334155] text-sm leading-relaxed pr-8">
    {answer}
  </div>
</details>
