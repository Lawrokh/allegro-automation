---
const success = Astro.url.searchParams.get('success') === 'true';
const base = import.meta.env.BASE_URL;
---

{success && (
  <div class="mb-8 bg-green-50 border border-green-200 rounded-xl p-5 flex items-start gap-3">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 mt-0.5" aria-hidden="true">
      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
      <polyline points="22 4 12 14.01 9 11.01"/>
    </svg>
    <div>
      <p class="font-semibold text-green-800">Wiadomość wysłana!</p>
      <p class="text-sm text-green-700 mt-1">Dziękujemy za kontakt. Odpowiemy w ciągu 24 godzin roboczych.</p>
    </div>
  </div>
)}

<form
  action="https://formspree.io/f/YOUR_FORMSPREE_FORM_ID"
  method="POST"
  class="space-y-6"
  novalidate
>
  <!-- Honeypot -->
  <input type="text" name="_gotcha" class="hidden" aria-hidden="true" tabindex="-1" autocomplete="off" />
  <input type="hidden" name="_subject" value="Nowe zapytanie z AllegroAuto" />
  <input type="hidden" name="_next" value={`${base}kontakt?success=true`} />

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <!-- Imię i nazwisko -->
    <div class="sm:col-span-2">
      <label for="name" class="block text-sm font-medium text-[#0F172A] mb-1.5">
        Imię i nazwisko <span class="text-red-500">*</span>
      </label>
      <input
        type="text"
        id="name"
        name="name"
        required
        autocomplete="name"
        placeholder="Jan Kowalski"
        class="w-full border border-[#E2E8F0] rounded-lg px-4 py-2.5 text-sm text-[#0F172A] placeholder-[#94A3B8] focus:border-[#0369A1] focus:ring-1 focus:ring-[#0369A1] focus:outline-none transition-colors duration-150"
      />
    </div>

    <!-- Email -->
    <div>
      <label for="email" class="block text-sm font-medium text-[#0F172A] mb-1.5">
        Adres e-mail <span class="text-red-500">*</span>
      </label>
      <input
        type="email"
        id="email"
        name="email"
        required
        autocomplete="email"
        placeholder="jan@sklep.pl"
        class="w-full border border-[#E2E8F0] rounded-lg px-4 py-2.5 text-sm text-[#0F172A] placeholder-[#94A3B8] focus:border-[#0369A1] focus:ring-1 focus:ring-[#0369A1] focus:outline-none transition-colors duration-150"
      />
    </div>

    <!-- Telefon -->
    <div>
      <label for="phone" class="block text-sm font-medium text-[#0F172A] mb-1.5">
        Telefon <span class="text-[#94A3B8] font-normal">(opcjonalny)</span>
      </label>
      <input
        type="tel"
        id="phone"
        name="phone"
        autocomplete="tel"
        placeholder="+48 500 000 000"
        class="w-full border border-[#E2E8F0] rounded-lg px-4 py-2.5 text-sm text-[#0F172A] placeholder-[#94A3B8] focus:border-[#0369A1] focus:ring-1 focus:ring-[#0369A1] focus:outline-none transition-colors duration-150"
      />
    </div>

    <!-- Firma -->
    <div class="sm:col-span-2">
      <label for="company" class="block text-sm font-medium text-[#0F172A] mb-1.5">
        Nazwa firmy <span class="text-[#94A3B8] font-normal">(opcjonalna)</span>
      </label>
      <input
        type="text"
        id="company"
        name="company"
        autocomplete="organization"
        placeholder="Sklep XYZ Sp. z o.o."
        class="w-full border border-[#E2E8F0] rounded-lg px-4 py-2.5 text-sm text-[#0F172A] placeholder-[#94A3B8] focus:border-[#0369A1] focus:ring-1 focus:ring-[#0369A1] focus:outline-none transition-colors duration-150"
      />
    </div>

    <!-- Temat -->
    <div class="sm:col-span-2">
      <label for="subject" class="block text-sm font-medium text-[#0F172A] mb-1.5">
        Temat <span class="text-red-500">*</span>
      </label>
      <select
        id="subject"
        name="subject"
        required
        class="w-full border border-[#E2E8F0] rounded-lg px-4 py-2.5 text-sm text-[#0F172A] focus:border-[#0369A1] focus:ring-1 focus:ring-[#0369A1] focus:outline-none transition-colors duration-150 cursor-pointer bg-white"
      >
        <option value="" disabled selected>Wybierz temat...</option>
        <option value="trial">Bezpłatny trial</option>
        <option value="demo">Prośba o demo</option>
        <option value="pricing">Pytanie o cennik</option>
        <option value="integration">Pytanie o integrację</option>
        <option value="support">Wsparcie techniczne</option>
        <option value="other">Inne</option>
      </select>
    </div>

    <!-- Wiadomość -->
    <div class="sm:col-span-2">
      <label for="message" class="block text-sm font-medium text-[#0F172A] mb-1.5">
        Wiadomość <span class="text-red-500">*</span>
      </label>
      <textarea
        id="message"
        name="message"
        required
        rows={5}
        placeholder="Opisz swoje potrzeby lub pytania..."
        class="w-full border border-[#E2E8F0] rounded-lg px-4 py-2.5 text-sm text-[#0F172A] placeholder-[#94A3B8] focus:border-[#0369A1] focus:ring-1 focus:ring-[#0369A1] focus:outline-none transition-colors duration-150 resize-y min-h-[120px]"
      ></textarea>
    </div>
  </div>

  <div class="flex items-center justify-between gap-4 flex-wrap">
    <p class="text-xs text-[#94A3B8]">
      Pola oznaczone <span class="text-red-500">*</span> są wymagane
    </p>
    <button
      type="submit"
      class="bg-[#0369A1] text-white px-8 py-3 rounded-lg text-sm font-semibold hover:bg-[#0EA5E9] transition-colors duration-150 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0369A1] focus-visible:ring-offset-2"
    >
      Wyślij wiadomość
    </button>
  </div>
</form>
