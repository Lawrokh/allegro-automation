---
// Web3Forms - darmowy formularz (250/mies.), bez backendu
// Klucz API: wejdź na https://web3forms.com, wpisz swój email → dostaniesz klucz na maila
const WEB3FORMS_KEY = '4b15f354-0602-4b6f-a5a5-9cd6768f45d8';
---

<div id="form-success" class="hidden mb-8 bg-green-50 border border-green-200 rounded-xl p-5 flex items-start gap-3" role="alert">
  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 mt-0.5" aria-hidden="true">
    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
    <polyline points="22 4 12 14.01 9 11.01"/>
  </svg>
  <div>
    <p class="font-semibold text-green-800">Wiadomość wysłana!</p>
    <p class="text-sm text-green-700 mt-1">Dziękujemy za kontakt. Odpowiemy w ciągu 24 godzin roboczych.</p>
  </div>
</div>

<div id="form-error" class="hidden mb-8 bg-red-50 border border-red-200 rounded-xl p-5 flex items-start gap-3" role="alert">
  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#DC2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 mt-0.5" aria-hidden="true">
    <circle cx="12" cy="12" r="10"/>
    <line x1="12" y1="8" x2="12" y2="12"/>
    <line x1="12" y1="16" x2="12.01" y2="16"/>
  </svg>
  <div>
    <p class="font-semibold text-red-800">Coś poszło nie tak</p>
    <p class="text-sm text-red-700 mt-1">Spróbuj ponownie lub napisz bezpośrednio na kontakt@allegroauto.pl</p>
  </div>
</div>

<form id="contact-form" class="space-y-6" novalidate>
  <!-- Web3Forms - wymagane ukryte pola -->
  <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
  <input type="hidden" name="subject" value="Nowe zapytanie z AllegroAuto" />
  <input type="hidden" name="from_name" value="AllegroAuto - Formularz kontaktowy" />
  <!-- Honeypot anty-spam -->
  <input type="checkbox" name="botcheck" class="hidden" aria-hidden="true" tabindex="-1" />

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <!-- Imię i nazwisko -->
    <div class="sm:col-span-2">
      <label for="name" class="block text-sm font-medium text-[#0F172A] mb-1.5">
        Imię i nazwisko <span class="text-red-500">*</span>
      </label>
      <input
        type="text"
        id="name"
        name="name"
        required
        autocomplete="name"
        placeholder="Jan Kowalski"
        class="w-full border border-[#E2E8F0] rounded-lg px-4 py-2.5 text-sm text-[#0F172A] placeholder-[#94A3B8] focus:border-[#0369A1] focus:ring-1 focus:ring-[#0369A1] focus:outline-none transition-colors duration-150"
      />
      <p class="hidden mt-1.5 text-xs text-red-600" data-error="name">Podaj imię i nazwisko.</p>
    </div>

    <!-- Email -->
    <div>
      <label for="email" class="block text-sm font-medium text-[#0F172A] mb-1.5">
        Adres e-mail <span class="text-red-500">*</span>
      </label>
      <input
        type="email"
        id="email"
        name="email"
        required
        autocomplete="email"
        placeholder="jan@sklep.pl"
        class="w-full border border-[#E2E8F0] rounded-lg px-4 py-2.5 text-sm text-[#0F172A] placeholder-[#94A3B8] focus:border-[#0369A1] focus:ring-1 focus:ring-[#0369A1] focus:outline-none transition-colors duration-150"
      />
      <p class="hidden mt-1.5 text-xs text-red-600" data-error="email">Podaj poprawny adres e-mail.</p>
    </div>

    <!-- Telefon -->
    <div>
      <label for="phone" class="block text-sm font-medium text-[#0F172A] mb-1.5">
        Telefon <span class="text-[#94A3B8] font-normal">(opcjonalny)</span>
      </label>
      <input
        type="tel"
        id="phone"
        name="phone"
        autocomplete="tel"
        placeholder="+48 500 000 000"
        class="w-full border border-[#E2E8F0] rounded-lg px-4 py-2.5 text-sm text-[#0F172A] placeholder-[#94A3B8] focus:border-[#0369A1] focus:ring-1 focus:ring-[#0369A1] focus:outline-none transition-colors duration-150"
      />
    </div>

    <!-- Firma -->
    <div class="sm:col-span-2">
      <label for="company" class="block text-sm font-medium text-[#0F172A] mb-1.5">
        Nazwa firmy <span class="text-[#94A3B8] font-normal">(opcjonalna)</span>
      </label>
      <input
        type="text"
        id="company"
        name="company"
        autocomplete="organization"
        placeholder="Sklep XYZ Sp. z o.o."
        class="w-full border border-[#E2E8F0] rounded-lg px-4 py-2.5 text-sm text-[#0F172A] placeholder-[#94A3B8] focus:border-[#0369A1] focus:ring-1 focus:ring-[#0369A1] focus:outline-none transition-colors duration-150"
      />
    </div>

    <!-- Temat -->
    <div class="sm:col-span-2">
      <label for="topic" class="block text-sm font-medium text-[#0F172A] mb-1.5">
        Temat <span class="text-red-500">*</span>
      </label>
      <select
        id="topic"
        name="topic"
        required
        class="w-full border border-[#E2E8F0] rounded-lg px-4 py-2.5 text-sm text-[#0F172A] focus:border-[#0369A1] focus:ring-1 focus:ring-[#0369A1] focus:outline-none transition-colors duration-150 cursor-pointer bg-white"
      >
        <option value="" disabled selected>Wybierz temat...</option>
        <option value="Bezpłatny trial">Bezpłatny trial</option>
        <option value="Prośba o demo">Prośba o demo</option>
        <option value="Pytanie o cennik">Pytanie o cennik</option>
        <option value="Pytanie o integrację">Pytanie o integrację</option>
        <option value="Wsparcie techniczne">Wsparcie techniczne</option>
        <option value="Inne">Inne</option>
      </select>
      <p class="hidden mt-1.5 text-xs text-red-600" data-error="topic">Wybierz temat wiadomości.</p>
    </div>

    <!-- Wiadomość -->
    <div class="sm:col-span-2">
      <label for="message" class="block text-sm font-medium text-[#0F172A] mb-1.5">
        Wiadomość <span class="text-red-500">*</span>
      </label>
      <textarea
        id="message"
        name="message"
        required
        rows={5}
        placeholder="Opisz swoje potrzeby lub pytania..."
        class="w-full border border-[#E2E8F0] rounded-lg px-4 py-2.5 text-sm text-[#0F172A] placeholder-[#94A3B8] focus:border-[#0369A1] focus:ring-1 focus:ring-[#0369A1] focus:outline-none transition-colors duration-150 resize-y min-h-[120px]"
      ></textarea>
      <p class="hidden mt-1.5 text-xs text-red-600" data-error="message">Wpisz treść wiadomości.</p>
    </div>
  </div>

  <div class="flex items-center justify-between gap-4 flex-wrap">
    <p class="text-xs text-[#94A3B8]">
      Pola oznaczone <span class="text-red-500">*</span> są wymagane
    </p>
    <button
      id="submit-btn"
      type="submit"
      class="inline-flex items-center gap-2 bg-[#0369A1] text-white px-8 py-3 rounded-lg text-sm font-semibold hover:bg-[#0EA5E9] transition-colors duration-150 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0369A1] focus-visible:ring-offset-2 disabled:opacity-60 disabled:cursor-not-allowed"
    >
      <span id="submit-text">Wyślij wiadomość</span>
      <svg id="submit-spinner" class="hidden animate-spin" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
      </svg>
    </button>
  </div>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const submitText = document.getElementById('submit-text') as HTMLSpanElement;
  const submitSpinner = document.getElementById('submit-spinner') as SVGElement;
  const successBox = document.getElementById('form-success') as HTMLDivElement;
  const errorBox = document.getElementById('form-error') as HTMLDivElement;

  function showError(field: string, show: boolean) {
    const el = form.querySelector(`[data-error="${field}"]`) as HTMLElement | null;
    if (el) el.classList.toggle('hidden', !show);
  }

  function validate(): boolean {
    const name = (form.querySelector('#name') as HTMLInputElement).value.trim();
    const email = (form.querySelector('#email') as HTMLInputElement).value.trim();
    const topic = (form.querySelector('#topic') as HTMLSelectElement).value;
    const message = (form.querySelector('#message') as HTMLTextAreaElement).value.trim();
    const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    let valid = true;

    showError('name', !name);
    if (!name) valid = false;

    showError('email', !email || !emailRe.test(email));
    if (!email || !emailRe.test(email)) valid = false;

    showError('topic', !topic);
    if (!topic) valid = false;

    showError('message', !message);
    if (!message) valid = false;

    return valid;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    successBox.classList.add('hidden');
    errorBox.classList.add('hidden');

    if (!validate()) {
      const firstError = form.querySelector('[data-error]:not(.hidden)');
      firstError?.previousElementSibling?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }

    submitBtn.disabled = true;
    submitText.textContent = 'Wysyłanie...';
    submitSpinner.classList.remove('hidden');

    try {
      const data = new FormData(form);
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: data,
      });
      const json = await res.json();

      if (json.success) {
        form.reset();
        successBox.classList.remove('hidden');
        successBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else {
        errorBox.classList.remove('hidden');
        errorBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    } catch {
      errorBox.classList.remove('hidden');
      errorBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } finally {
      submitBtn.disabled = false;
      submitText.textContent = 'Wyślij wiadomość';
      submitSpinner.classList.add('hidden');
    }
  });
</script>
