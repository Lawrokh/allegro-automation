---
import SectionHeader from '../ui/SectionHeader.astro';
import PricingCard from '../ui/PricingCard.astro';
import { pricingPlans } from '../../data/pricing';

const base = import.meta.env.BASE_URL;
---

<section class="section-padding bg-[#F8FAFC]" id="cennik">
  <div class="container-main">
    <SectionHeader
      pretitle="Cennik"
      title="Prosty, przejrzysty cennik"
      subtitle="Bez ukrytych opłat. Zacznij od bezpłatnego 14-dniowego trialu — bez karty kredytowej."
      align="center"
    />
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-start">
      {pricingPlans.map((plan) => (
        <PricingCard
          name={plan.name}
          price={plan.price}
          period={plan.period}
          description={plan.description}
          features={plan.features}
          badge={plan.badge}
          highlighted={plan.highlighted}
          ctaText={plan.ctaText}
          ctaHref={plan.ctaHref}
        />
      ))}
    </div>
    <p class="text-center text-sm text-[#334155] mt-10">
      Potrzebujesz niestandardowego rozwiązania?
      <a href={`${base}kontakt`} class="text-[#0369A1] font-semibold hover:text-[#0EA5E9] transition-colors duration-150 cursor-pointer ml-1">
        Skontaktuj się z nami
      </a>
    </p>
  </div>
</section>
